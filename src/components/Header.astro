---
const links = [
  { href: "/", label: "Home" },
  { href: "/casas", label: "Casas" },
  { href: "/deco-studio", label: "Deco Studio" },
  { href: "/nosotros", label: "Nosotros" },
  { href: "/contacto", label: "Contacto" },
];

const currentPath = Astro.url.pathname;

const pillClass =
  "block rounded-[0.1875rem] bg-brand-grey py-[0.8rem] pl-[0.8rem] pr-[0.8rem] md:pr-0 md:min-w-[11.5rem] text-base font-light uppercase tracking-[0.0625rem] [word-spacing:0.1875rem] text-white shadow-[0_0.125rem_0.25rem_rgba(0,0,0,0.5)] transition-colors hover:bg-black/20";
---

<header class="relative w-full bg-brand-grey">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-4 py-4 md:px-8">
    <a href="/" class="flex items-center gap-4">
      <img
        src="https://i.ibb.co/1J7V4xFq/logo-letra-banca-sin-fondo.png"
        alt="Logo Ramirez Arquitectura"
        class="h-[3.5rem] w-auto md:h-[5.5rem]"
      />
      <span class="text-lg font-[350] uppercase tracking-[2px] [word-spacing:3px] text-white md:text-[30px] md:tracking-[5px] md:[word-spacing:6px]">
        Ramirez Arquitectura
      </span>
    </a>

    <button
      id="menu-toggle"
      type="button"
      class="flex items-center gap-2 rounded-[0.1875rem] bg-brand-grey px-[1rem] py-[0.8rem] text-white shadow-[0_0.125rem_0.25rem_rgba(0,0,0,0.5)] transition-colors hover:bg-black/20"
      aria-expanded="false"
      aria-controls="main-nav"
      aria-label="Abrir menú"
    >
      <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <nav
    id="main-nav"
    class="hidden absolute right-4 top-full z-20 mt-2 w-[min(90vw,20rem)] md:right-8 md:w-max"
  >
    <ul class="flex flex-col gap-[0.2rem]">
      {links.map((link) => {
        const isActive = currentPath === link.href;
        return (
          <li>
            <a
              href={link.href}
              aria-current={isActive ? "page" : undefined}
              class:list={[pillClass, isActive && "bg-black/20"]}
            >
              {link.label}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const nav = document.getElementById("main-nav");
  const iconOpen = document.getElementById("icon-open");
  const iconClose = document.getElementById("icon-close");

  toggle?.addEventListener("click", () => {
    const isHidden = nav?.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", String(!isHidden));
    iconOpen?.classList.toggle("hidden");
    iconClose?.classList.toggle("hidden");
  });

  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Node)) return;
    if (nav?.classList.contains("hidden")) return;
    if (toggle?.contains(event.target) || nav?.contains(event.target)) return;
    nav?.classList.add("hidden");
    toggle?.setAttribute("aria-expanded", "false");
    iconOpen?.classList.remove("hidden");
    iconClose?.classList.add("hidden");
  });
</script>
