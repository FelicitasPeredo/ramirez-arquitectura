---
const links = [
  { href: "/", label: "Home" },
  { href: "/casas", label: "Casas" },
  { href: "/deco-studio", label: "Deco Studio" },
  { href: "/nosotros", label: "Nosotros" },
  { href: "/contacto", label: "Contacto" },
];

const currentPath = Astro.url.pathname;

const pillClass =
  "block rounded-[0.1875rem] bg-brand-grey py-[0.8rem] pl-[0.8rem] pr-[0.8rem] md:pr-0 md:min-w-[11.5rem] text-base font-light uppercase tracking-[0.0625rem] [word-spacing:0.1875rem] text-white shadow-[0_0.125rem_0.25rem_rgba(0,0,0,0.5)] transition-colors hover:bg-black/20";
---

<header class="relative w-full bg-brand-grey">
  <div class="flex w-full items-center justify-between gap-4 px-4 py-4 md:px-8">
    <a href="/" class="flex min-w-0 items-center gap-4">
      <img
        src="https://i.ibb.co/1J7V4xFq/logo-letra-banca-sin-fondo.png"
        alt="Logo Ramirez Arquitectura"
        class="h-[3.5rem] w-auto shrink-0 md:h-[5.5rem]"
      />
      <span class="min-w-0 break-words text-lg font-[350] uppercase tracking-[5px] [word-spacing:6px] text-white md:text-[30px]">
        Ramirez Arquitectura
      </span>
    </a>

    <button
      id="menu-toggle"
      type="button"
      class="shrink-0 rounded-[0.1875rem] bg-brand-grey py-[0.8rem] pl-[0.8rem] pr-[0.8rem] text-base font-light uppercase tracking-[0.0625rem] [word-spacing:0.1875rem] text-white shadow-[0_0.125rem_0.25rem_rgba(0,0,0,0.5)] transition-colors hover:bg-black/20 md:min-w-[8rem] md:pr-0 md:text-left"
      aria-expanded="false"
      aria-controls="main-nav"
      aria-label="Abrir menú"
    >
      <span id="menu-toggle-label">Menu</span>
    </button>
  </div>

  <nav
    id="main-nav"
    class="hidden absolute right-4 top-full z-20 mt-2 w-[min(90vw,20rem)] md:right-8 md:w-max"
  >
    <ul class="flex flex-col gap-[0.2rem]">
      {links.map((link) => {
        const isActive = currentPath === link.href;
        return (
          <li>
            <a
              href={link.href}
              aria-current={isActive ? "page" : undefined}
              class:list={[pillClass, isActive && "bg-black/20"]}
            >
              {link.label}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const nav = document.getElementById("main-nav");
  const label = document.getElementById("menu-toggle-label");

  const setOpen = (open: boolean) => {
    nav?.classList.toggle("hidden", !open);
    toggle?.setAttribute("aria-expanded", String(open));
    if (label) label.textContent = open ? "Cerrar" : "Menu";
  };

  toggle?.addEventListener("click", () => {
    setOpen(nav?.classList.contains("hidden") ?? false);
  });

  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Node)) return;
    if (nav?.classList.contains("hidden")) return;
    if (toggle?.contains(event.target) || nav?.contains(event.target)) return;
    setOpen(false);
  });
</script>
